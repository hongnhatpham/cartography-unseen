{
  "name": "cartography-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .worker-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply monitor --local",
    "credential": "node scripts/credential.mjs"
  },
  "dependencies": { "jose": "^6.1.3", "zod": "^4.3.6" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.131.0"
  }
}
